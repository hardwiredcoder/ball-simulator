{
"description": "A simple 2D physics engine for simulating balls that I made from scratch. It's just to help me understand raylib before I start developing other things.",
	"dependencies": {
		"raylib-d": "~>6.0.1"
	},
	"authors": [
		"Elijah S."
	],
	"copyright": "Copyright © 2026, Elijah S.",
	"license": "MIT",
	"name": "ball-simulator",

    "configurations": [
        {
            "name": "osx",
            "platforms": ["osx"],
            "targetType": "executable",
            "libs": [
                "raylib"
            ],
            "lflags": [
                "-L/opt/homebrew/lib",
                "-framework", "IOKit",
                "-framework", "Cocoa",
                "-framework", "OpenGL"
            ]
        }
    ]
}
