	"lflags-linux": [
		"-rpath=$$ORIGIN"
	],
	"license": "MIT",
	"copyright": "Copyright © 2026, Elijah S.",
	"name": "ball-simulator",
	"libs": [
		"raylib"
	],
	"lflags-posix": [
		"-L."
	],
	"description": "A simple 2D physics engine for simulating balls that I made from scratch. It's just to help me understand raylib before I start developing other things.",
	"dependencies": {
		"raylib-d": "~>6.0.1"
	},
	"configurations": [
		{
			"platforms": [
				"linux"
			],
			"targetType": "executable",
			"libs": [
				"raylib",
				"GL",
				"m",
				"pthread",
				"dl",
				"rt",
				"X11"
			],
			"name": "linux-app"
		}
	],
	"lflags-osx": [
		"-rpath",
		"@executable_path/"
	]
}
